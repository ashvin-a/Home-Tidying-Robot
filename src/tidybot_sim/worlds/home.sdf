<?xml version="1.0"?>
<!--
  home.sdf — The simulation world.
  PHASE 1: ground plane + outer boundary walls + lighting + physics config.
           Full two-room layout (walls, doorway, furniture, objects)
           comes in Phase 3.-->
<sdf version="1.9">
<world name="home">

  <!-- 
       PHYSICS CONFIGURATION
       type="ignored" means "let the physics engine decide which solver
       to use" — the <physics> block still sets the parameters.

       max_step_size: the physics timestep in seconds.
         Smaller = more accurate but slower. 4ms is a good balance.
         Too large (>10ms) causes robots to pass through walls.
         Too small (<1ms) makes real-time factor drop below 1.0.

       real_time_factor: 1.0 = simulation runs at wall-clock speed.
         <1.0 means simulation is slower than real time (overloaded).
   -->
  <physics name="4ms" type="ignored">
    <max_step_size>0.004</max_step_size>
    <real_time_factor>1.0</real_time_factor>
    <gravity>0 0 -9.81</gravity>
  </physics>

  <!-- 
       MANDATORY WORLD PLUGINS
       Filename pattern: "ignition-gazebo-*-system"
       Ignition's plugin loader finds libignition-gazebo6-*-system.so
   -->
  <plugin filename="ignition-gazebo-physics-system"
          name="ignition::gazebo::systems::Physics"/>

  <plugin filename="ignition-gazebo-user-commands-system"
          name="ignition::gazebo::systems::UserCommands"/>

  <plugin filename="ignition-gazebo-scene-broadcaster-system"
          name="ignition::gazebo::systems::SceneBroadcaster"/>

  <!-- SENSORS PLUGIN -->
  <plugin filename="ignition-gazebo-sensors-system"
          name="ignition::gazebo::systems::Sensors">
    <render_engine>ogre2</render_engine>
  </plugin>

  <!-- LIGHTING-->
  <light name="sun" type="directional">
    <cast_shadows>true</cast_shadows>
    <pose>0 0 10 0 0 0</pose>
    <diffuse>0.85 0.85 0.85 1</diffuse>
    <specular>0.2 0.2 0.2 1</specular>
    <direction>-0.5 0.1 -0.9</direction>
  </light>

  <!-- Softer ambient fill light to avoid pitch-black shadows -->
  <light name="ambient_fill" type="directional">
    <cast_shadows>false</cast_shadows>
    <pose>0 0 10 0 0 0</pose>
    <diffuse>0.3 0.3 0.35 1</diffuse>
    <specular>0.0 0.0 0.0 1</specular>
    <direction>0.5 -0.1 -0.5</direction>
  </light>

  <!-- GROUND PLANE
       A static model with plane collision + visual geometry.
       IMPORTANT: We define friction here, not relying on the default-->
  <model name="ground_plane">
    <static>true</static>
    <link name="link">

      <collision name="collision">
        <geometry>
          <!-- A plane is infinite in collision but we give it a visual size -->
          <plane>
            <normal>0 0 1</normal>   <!-- pointing up = horizontal floor -->
            <size>30 30</size>
          </plane>
        </geometry>
        <surface>
          <friction>
            <ode>
              <!-- mu: Coulomb friction (0.8 = decent grip, like rubber on concrete)
                   This is what makes wheels actually propel the robot forward.
                   Zero friction = wheels spin, robot doesn't move. -->
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <!-- Stiffness and damping for the contact model.
                   Without these, objects may bounce or sink into the floor. -->
              <kp>1e6</kp>
              <kd>100.0</kd>
            </ode>
          </contact>
        </surface>
      </collision>

      <visual name="visual">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>30 30</size>
          </plane>
        </geometry>
        <material>
          <ambient>0.7 0.7 0.7 1</ambient>
          <diffuse>0.7 0.7 0.7 1</diffuse>
        </material>
      </visual>

    </link>
  </model>

  <!-- 
       WALL HELPER: we define walls as static box models.
       Each wall has:
         pose: center position (x y z roll pitch yaw)
         size: (length thickness height)

       Wall layout for Phase 1: simple outer perimeter of one large room.
       Phase 3 splits this into two rooms with a doorway.

       Room boundary: 10m wide × 9m deep
       Wall thickness: 0.15m
       Wall height: 2.4m
   -->

  <!-- Reusable wall material -->
  <!-- (SDF doesn't support macros — we repeat the material block.
       In Phase 3 we'll have more walls but the structure is the same.) -->

  <!-- South wall (runs along X axis at y = -4.5) -->
  <model name="wall_south">
    <static>true</static>
    <!-- pose: cx cy cz roll pitch yaw — center of the box -->
    <pose>4.75 -4.575 1.2 0 0 0</pose>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>9.65 0.15 2.4</size></box></geometry>
        <surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><box><size>9.65 0.15 2.4</size></box></geometry>
        <material><ambient>0.9 0.9 0.88 1</ambient><diffuse>0.9 0.9 0.88 1</diffuse></material>
      </visual>
    </link>
  </model>

  <!-- North wall (runs along X axis at y = +4.5) -->
  <model name="wall_north">
    <static>true</static>
    <pose>4.75 4.575 1.2 0 0 0</pose>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>9.65 0.15 2.4</size></box></geometry>
        <surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><box><size>9.65 0.15 2.4</size></box></geometry>
        <material><ambient>0.9 0.9 0.88 1</ambient><diffuse>0.9 0.9 0.88 1</diffuse></material>
      </visual>
    </link>
  </model>

  <!-- West wall (runs along Y axis at x = -0.075) -->
  <model name="wall_west">
    <static>true</static>
    <pose>-0.075 0 1.2 0 0 0</pose>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.15 9.0 2.4</size></box></geometry>
        <surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.15 9.0 2.4</size></box></geometry>
        <material><ambient>0.9 0.9 0.88 1</ambient><diffuse>0.9 0.9 0.88 1</diffuse></material>
      </visual>
    </link>
  </model>

  <!-- East wall (runs along Y axis at x = 9.575) -->
  <model name="wall_east">
    <static>true</static>
    <pose>9.575 0 1.2 0 0 0</pose>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.15 9.0 2.4</size></box></geometry>
        <surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.15 9.0 2.4</size></box></geometry>
        <material><ambient>0.9 0.9 0.88 1</ambient><diffuse>0.9 0.9 0.88 1</diffuse></material>
      </visual>
    </link>
  </model>

  <!-- ═══════════════════════════════════════════════════════════════
       PHASE 3: TWO-ROOM HOME LAYOUT

       Coordinate system:
         X: west(-) → east(+),  robot moves in +X to go from R1 to R2
         Y: south(-) → north(+)
         Z: up

       Room 1 (living room): x = 0   → 5.0,  y = -4.5 → +4.5
       Room 2 (study):       x = 5.0 → 9.5,  y = -4.5 → +4.5
       Doorway:              x = 5.0, y = -0.5 → +0.5  (1.0m gap)

       SDF model structure:
         <model>
           <static>true/false</static>       static = immovable (walls, furniture)
           <pose>x y z roll pitch yaw</pose>  pose of the model's origin
           <link name="link">
             <inertial>...</inertial>         REQUIRED for dynamic models
             <collision name="c">...</collision>
             <visual name="v">...</visual>
           </link>
         </model>

       KEY RULE: static models need NO inertial block.
                 dynamic models (pickup objects) MUST have a correct inertial.
                 A dynamic model with wrong inertia explodes on spawn.
  ═══════════════════════════════════════════════════════════════ -->

  <!-- ─────────────────────────────────────────────────────────────────
       INTERNAL DIVIDING WALL
       One wall at x=5.0 split into two segments around the doorway.
       Doorway: 1.0m gap centered at y=0, so segments are:
         south: y = -4.5 to -0.5   (4.0m long, center at y=-2.5)
         north: y = +0.5 to +4.5   (4.0m long, center at y=+2.5)

       Why two separate models instead of one?
         SDF does not support "cut-outs" in geometry.
         The only way to make a gap is to split the wall into segments.
         This is standard practice in Gazebo world-building.
  ───────────────────────────────────────────────────────────────── -->

  <model name="divider_south">
    <static>true</static>
    <pose>5.0 -2.5 1.2 0 0 0</pose>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.15 4.0 2.4</size></box></geometry>
        <surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.15 4.0 2.4</size></box></geometry>
        <material><ambient>0.9 0.9 0.88 1</ambient><diffuse>0.9 0.9 0.88 1</diffuse></material>
      </visual>
    </link>
  </model>

  <model name="divider_north">
    <static>true</static>
    <pose>5.0 2.5 1.2 0 0 0</pose>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.15 4.0 2.4</size></box></geometry>
        <surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.15 4.0 2.4</size></box></geometry>
        <material><ambient>0.9 0.9 0.88 1</ambient><diffuse>0.9 0.9 0.88 1</diffuse></material>
      </visual>
    </link>
  </model>

  <!-- ─────────────────────────────────────────────────────────────────
       ROOM 1 FURNITURE
       Robot starts at (0.5, 0.0). Furniture placed to constrain paths
       but leave the central corridor (y ≈ 0) clear for navigation.

       Table: 1.2×0.7×0.75m box — pose z = height/2 = 0.375 so bottom
              touches ground. Same rule applies to all furniture below.
  ───────────────────────────────────────────────────────────────── -->

  <!-- Dining table in south half of Room 1 -->
  <model name="r1_table">
    <static>true</static>
    <pose>2.5 -2.2 0.375 0 0 0</pose>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>1.2 0.7 0.75</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>1.2 0.7 0.75</size></box></geometry>
        <!-- Wood-brown color -->
        <material><ambient>0.55 0.35 0.15 1</ambient><diffuse>0.55 0.35 0.15 1</diffuse></material>
      </visual>
    </link>
  </model>

  <model name="r1_chair_a">
    <static>true</static>
    <pose>1.8 -3.2 0.425 0 0 0</pose>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.45 0.45 0.85</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.45 0.45 0.85</size></box></geometry>
        <material><ambient>0.7 0.5 0.25 1</ambient><diffuse>0.7 0.5 0.25 1</diffuse></material>
      </visual>
    </link>
  </model>

  <model name="r1_chair_b">
    <static>true</static>
    <pose>3.2 -3.2 0.425 0 0 0</pose>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.45 0.45 0.85</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.45 0.45 0.85</size></box></geometry>
        <material><ambient>0.7 0.5 0.25 1</ambient><diffuse>0.7 0.5 0.25 1</diffuse></material>
      </visual>
    </link>
  </model>

  <!-- Couch in north half of Room 1 — placed against north wall -->
  <model name="r1_couch">
    <static>true</static>
    <pose>3.0 3.5 0.425 0 0 0</pose>
    <link name="link">
      <collision name="collision">
        <!-- Couch is wide (along X) and shallow (Y), tall (Z) -->
        <geometry><box><size>1.8 0.8 0.85</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>1.8 0.8 0.85</size></box></geometry>
        <!-- Blue-grey upholstery -->
        <material><ambient>0.25 0.35 0.6 1</ambient><diffuse>0.25 0.35 0.6 1</diffuse></material>
      </visual>
    </link>
  </model>

  <!-- ─────────────────────────────────────────────────────────────────
       ROOM 2 FURNITURE
       Navigation enters from the doorway at (5.5, 0) and sweeps
       through the room. Furniture kept in south and far-north areas.
  ───────────────────────────────────────────────────────────────── -->

  <model name="r2_table">
    <static>true</static>
    <pose>7.0 -2.2 0.375 0 0 0</pose>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>1.2 0.7 0.75</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>1.2 0.7 0.75</size></box></geometry>
        <material><ambient>0.55 0.35 0.15 1</ambient><diffuse>0.55 0.35 0.15 1</diffuse></material>
      </visual>
    </link>
  </model>

  <model name="r2_chair_a">
    <static>true</static>
    <pose>6.3 -3.2 0.425 0 0 0</pose>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.45 0.45 0.85</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.45 0.45 0.85</size></box></geometry>
        <material><ambient>0.7 0.5 0.25 1</ambient><diffuse>0.7 0.5 0.25 1</diffuse></material>
      </visual>
    </link>
  </model>

  <model name="r2_chair_b">
    <static>true</static>
    <pose>7.7 -3.2 0.425 0 0 0</pose>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.45 0.45 0.85</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.45 0.45 0.85</size></box></geometry>
        <material><ambient>0.7 0.5 0.25 1</ambient><diffuse>0.7 0.5 0.25 1</diffuse></material>
      </visual>
    </link>
  </model>

  <!-- Shelf in Room 2 — against the east wall (x ≈ 9.5) -->
  <model name="r2_shelf">
    <static>true</static>
    <!-- x=9.1: shelf east face at 9.1+0.2=9.3, 0.2m from east wall interior face ✓ -->
    <pose>9.1 2.5 0.9 0 0 0</pose>
    <link name="link">
      <collision name="collision">
        <!-- Depth 0.4m (X), Width 1.5m (Y), Height 1.8m (Z) -->
        <geometry><box><size>0.4 1.5 1.8</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.4 1.5 1.8</size></box></geometry>
        <!-- Dark wood -->
        <material><ambient>0.4 0.25 0.1 1</ambient><diffuse>0.4 0.25 0.1 1</diffuse></material>
      </visual>
    </link>
  </model>

  <!-- ─────────────────────────────────────────────────────────────────
       COLLECTION BOX
       An open-top hollow box near the robot's start position.
       Objects the robot picks up are deposited here.

       Implementation: 5 separate static models (floor + 4 walls).
       SDF has no subtraction/hollow geometry — the only way to make
       an open-top box is to assemble it from flat panels.

       Outer dimensions: 0.7m × 0.7m × 0.45m
       Wall thickness: 0.02m
       Center position: (1.5, 2.0) in world frame

       Panel center calculations:
         box_center = (1.5, 2.0),  half_outer = 0.35,  half_wall = 0.01
         North y = 2.0 + 0.35 - 0.01 = 2.34
         South y = 2.0 - 0.35 + 0.01 = 1.66
         East  x = 1.5 + 0.35 - 0.01 = 1.84
         West  x = 1.5 - 0.35 + 0.01 = 1.16
         Wall height center z = 0.45/2 = 0.225
  ───────────────────────────────────────────────────────────────── -->

  <model name="box_floor">
    <static>true</static>
    <pose>1.5 2.0 0.01 0 0 0</pose>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.70 0.70 0.02</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.70 0.70 0.02</size></box></geometry>
        <material><ambient>0.15 0.6 0.15 1</ambient><diffuse>0.15 0.6 0.15 1</diffuse></material>
      </visual>
    </link>
  </model>

  <model name="box_wall_north">
    <static>true</static>
    <pose>1.5 2.34 0.225 0 0 0</pose>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.70 0.02 0.45</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.70 0.02 0.45</size></box></geometry>
        <material><ambient>0.15 0.6 0.15 1</ambient><diffuse>0.15 0.6 0.15 1</diffuse></material>
      </visual>
    </link>
  </model>

  <model name="box_wall_south">
    <static>true</static>
    <pose>1.5 1.66 0.225 0 0 0</pose>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.70 0.02 0.45</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.70 0.02 0.45</size></box></geometry>
        <material><ambient>0.15 0.6 0.15 1</ambient><diffuse>0.15 0.6 0.15 1</diffuse></material>
      </visual>
    </link>
  </model>

  <model name="box_wall_east">
    <static>true</static>
    <pose>1.84 2.0 0.225 0 0 0</pose>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.02 0.70 0.45</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.02 0.70 0.45</size></box></geometry>
        <material><ambient>0.15 0.6 0.15 1</ambient><diffuse>0.15 0.6 0.15 1</diffuse></material>
      </visual>
    </link>
  </model>

  <model name="box_wall_west">
    <static>true</static>
    <pose>1.16 2.0 0.225 0 0 0</pose>
    <link name="link">
      <collision name="collision">
        <geometry><box><size>0.02 0.70 0.45</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.02 0.70 0.45</size></box></geometry>
        <material><ambient>0.15 0.6 0.15 1</ambient><diffuse>0.15 0.6 0.15 1</diffuse></material>
      </visual>
    </link>
  </model>

  <!-- ─────────────────────────────────────────────────────────────────
       PICKUP OBJECTS (6 dynamic models)
       These are the items the robot must collect.

       WHY dynamic (not static)?
         Static models are pinned to the world — the physics engine never
         moves them. We need these to be picked up, moved, and dropped
         into the collection box, so they must respond to forces.

       INERTIA CALCULATION (required for all dynamic models):
         Bad inertia = robot explodes on contact or objects phase through floor.

         Cylinder (r=0.04m, h=0.08m, mass=0.3kg):
           ixx = iyy = m/12*(3r²+h²) = 0.3/12*(3×0.0016+0.0064) = 0.000280 kg·m²
           izz        = m/2*r²        = 0.3/2*0.0016              = 0.000240 kg·m²

         Box (0.08×0.08×0.08m cube, mass=0.3kg):
           ixx=iyy=izz = m/12*(s²+s²) = 0.3/12*(0.0064+0.0064)   = 0.000320 kg·m²

       POSE: z = cylinder_radius (0.04) so bottom of object touches ground.
             For a cube: z = half_side = 0.04.

       SURFACE FRICTION: objects need enough friction to not slide away
         when the robot brushes against them, but not so much that they
         can't be pushed into position.
  ───────────────────────────────────────────────────────────────── -->

  <!-- Room 1 objects -->
  <model name="obj_red">
    <pose>3.0 1.0 0.04 0 0 0</pose>
    <link name="link">
      <inertial>
        <mass>0.3</mass>
        <inertia><ixx>0.000280</ixx><iyy>0.000280</iyy><izz>0.000240</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.04</radius><length>0.08</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction>
          <contact><ode><kp>1e5</kp><kd>10</kd></ode></contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.04</radius><length>0.08</length></cylinder></geometry>
        <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material>
      </visual>
    </link>
  </model>

  <model name="obj_green">
    <pose>1.5 -1.0 0.04 0 0 0</pose>
    <link name="link">
      <inertial>
        <mass>0.3</mass>
        <inertia><ixx>0.000280</ixx><iyy>0.000280</iyy><izz>0.000240</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.04</radius><length>0.08</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction>
          <contact><ode><kp>1e5</kp><kd>10</kd></ode></contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.04</radius><length>0.08</length></cylinder></geometry>
        <material><ambient>0.1 0.8 0.1 1</ambient><diffuse>0.1 0.8 0.1 1</diffuse></material>
      </visual>
    </link>
  </model>

  <!-- Blue box — near doorway approach path -->
  <model name="obj_blue">
    <!-- Box cube: z=0.04 = half of 0.08m side length -->
    <pose>4.0 -0.5 0.04 0 0 0</pose>
    <link name="link">
      <inertial>
        <mass>0.3</mass>
        <inertia><ixx>0.000320</ixx><iyy>0.000320</iyy><izz>0.000320</izz>
                 <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>0.08 0.08 0.08</size></box></geometry>
        <surface>
          <friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction>
          <contact><ode><kp>1e5</kp><kd>10</kd></ode></contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.08 0.08 0.08</size></box></geometry>
