<?xml version="1.0"?>
<!--
  tidybot.urdf.xacro — Complete robot description.

  PHASE 1: base_link + 4 wheels + DiffDrive plugin.
  Later phases add: torso, arms, sensors, face panel.

  URDF structure: a tree of links (rigid bodies) joined by joints.
  Every chain starts at base_link (the root, with no parent).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tidybot">

  <!-- ═══════════════════════════════════════════════════════════════
       INERTIA HELPER MACROS
       Always compute inertia from geometry — never use placeholder values.

       Box (m=mass, x/y/z=full side lengths):
         ixx = m/12*(y²+z²), iyy = m/12*(x²+z²), izz = m/12*(x²+y²)

       Cylinder (axis along Z, m=mass, r=radius, h=height):
         ixx = iyy = m/12*(3r²+h²),  izz = m/2*r²
  ═══════════════════════════════════════════════════════════════ -->

  <xacro:macro name="inertia_box" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m/12.0 * (y*y + z*z)}"
        iyy="${m/12.0 * (x*x + z*z)}"
        izz="${m/12.0 * (x*x + y*y)}"
        ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="inertia_cylinder" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m/12.0 * (3*r*r + h*h)}"
        iyy="${m/12.0 * (3*r*r + h*h)}"
        izz="${m/2.0  * r*r}"
        ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <!-- ═══════════════════════════════════════════════════════════════
       ROBOT DIMENSIONS
  ═══════════════════════════════════════════════════════════════ -->

  <!-- Base chassis -->
  <xacro:property name="base_x"    value="0.50"/>
  <xacro:property name="base_y"    value="0.48"/>
  <xacro:property name="base_z"    value="0.12"/>
  <xacro:property name="base_mass" value="8.0"/>

  <!-- Wheels -->
  <xacro:property name="wheel_r"     value="0.08"/>
  <xacro:property name="wheel_h"     value="0.05"/>
  <xacro:property name="wheel_mass"  value="0.6"/>
  <xacro:property name="wheel_x_off" value="0.15"/>
  <xacro:property name="wheel_y_off" value="${base_y/2.0 + wheel_h/2.0 + 0.005}"/>
  <xacro:property name="wheel_z_off" value="-0.05"/>
  <xacro:property name="wheel_sep"   value="${wheel_y_off * 2.0}"/>

  <!-- Torso -->
  <xacro:property name="torso_x"    value="0.20"/>
  <xacro:property name="torso_y"    value="0.16"/>
  <xacro:property name="torso_z"    value="0.55"/>
  <xacro:property name="torso_mass" value="3.5"/>
  <!-- Torso sits on top of base_link:
       joint z = base_z/2 + torso_z/2 = 0.06 + 0.275 = 0.335 -->
  <xacro:property name="torso_joint_z" value="${base_z/2.0 + torso_z/2.0}"/>

  <!-- Arm (both sides share the same segment lengths) -->
  <xacro:property name="upper_arm_len"   value="0.22"/>
  <xacro:property name="upper_arm_w"     value="0.07"/>
  <xacro:property name="forearm_len"     value="0.22"/>
  <xacro:property name="forearm_w"       value="0.06"/>
  <xacro:property name="gripper_base_x"  value="0.10"/>
  <xacro:property name="gripper_base_y"  value="0.08"/>
  <xacro:property name="gripper_base_z"  value="0.04"/>
  <xacro:property name="finger_x"        value="0.015"/>
  <xacro:property name="finger_y"        value="0.04"/>
  <xacro:property name="finger_z"        value="0.04"/>
  <!-- Shoulder joint position in torso frame.
       rpy="0 1.5707 0" makes the child-frame Z point forward (+X world),
       so at θ=0 the arm extends horizontally forward. No ground collision at spawn. -->
  <xacro:property name="shoulder_y_off"  value="0.09"/>   <!-- side offset from torso center -->
  <xacro:property name="shoulder_z"      value="0.05"/>   <!-- height on torso -->

  <!-- ═══════════════════════════════════════════════════════════════
       MATERIALS
  ═══════════════════════════════════════════════════════════════ -->

  <material name="dark_grey">  <color rgba="0.2 0.2 0.2 1.0"/> </material>
  <material name="wheel_black"><color rgba="0.1 0.1 0.1 1.0"/> </material>
  <material name="light_grey"> <color rgba="0.75 0.75 0.75 1.0"/></material>
  <material name="led_cyan">   <color rgba="0.0 0.85 0.85 1.0"/> </material>
  <material name="camera_red"> <color rgba="0.8 0.1 0.1 1.0"/> </material>
  <material name="lidar_black"><color rgba="0.05 0.05 0.05 1.0"/></material>
  <material name="arm_grey">   <color rgba="0.55 0.55 0.55 1.0"/></material>
  <material name="arm_left">   <color rgba="0.45 0.45 0.5 1.0"/> </material>
  <material name="gripper_dark"><color rgba="0.3 0.3 0.3 1.0"/> </material>

  <!-- ═══════════════════════════════════════════════════════════════
       ── PHASE 1 CONTENT ─────────────────────────────────────────
       BASE LINK + 4 WHEELS + DIFF DRIVE PLUGIN
  ═══════════════════════════════════════════════════════════════ -->

  <link name="base_link">
    <visual>
      <geometry><box size="${base_x} ${base_y} ${base_z}"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry><box size="${base_x} ${base_y} ${base_z}"/></geometry>
    </collision>
    <xacro:inertia_box m="${base_mass}" x="${base_x}" y="${base_y}" z="${base_z}"/>
  </link>

  <xacro:macro name="wheel" params="name x_sgn y_sgn">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="1.5707 0 0"/>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_h}"/></geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5707 0 0"/>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_h}"/></geometry>
      </collision>
      <xacro:inertia_cylinder m="${wheel_mass}" r="${wheel_r}" h="${wheel_h}"/>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${name}"/>
      <origin xyz="${x_sgn * wheel_x_off} ${y_sgn * wheel_y_off} ${wheel_z_off}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.5" friction="0.2"/>
    </joint>
    <gazebo reference="${name}">
      <mu1>0.8</mu1><mu2>0.8</mu2>
      <slip1>0.02</slip1><slip2>0.0</slip2>
      <fdir1>1 0 0</fdir1>
      <kp>1e6</kp><kd>100</kd>
    </gazebo>
  </xacro:macro>

  <xacro:wheel name="front_left_wheel"  x_sgn=" 1" y_sgn=" 1"/>
  <xacro:wheel name="front_right_wheel" x_sgn=" 1" y_sgn="-1"/>
  <xacro:wheel name="rear_left_wheel"   x_sgn="-1" y_sgn=" 1"/>
  <xacro:wheel name="rear_right_wheel"  x_sgn="-1" y_sgn="-1"/>

  <gazebo>
    <plugin filename="ignition-gazebo-diff-drive-system"
            name="ignition::gazebo::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>${wheel_sep}</wheel_separation>
      <wheel_radius>${wheel_r}</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>20</odom_publish_frequency>
      <max_linear_velocity>0.6</max_linear_velocity>
      <max_angular_velocity>1.2</max_angular_velocity>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="ignition-gazebo-joint-state-publisher-system"
            name="ignition::gazebo::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>

</robot>
